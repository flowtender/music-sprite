DISCORD_TOKEN=
# Register the commands in this guild only; they appear there instantly. Optional.
DISCORD_GUILD_ID=
# Name of the top-level slash command: commands are /<name> download, /<name> queue list, /<name> clean.
# Lowercase letters, digits, '-' and '_' only (Discord's rule), up to 32 characters.
# DISCORD_COMMAND_NAME=music_sprite
# Register the commands globally so they work in DMs with the bot (default: true).
# With DISCORD_GUILD_ID set, the global copies are DM-only so servers don't list each command twice;
# without it they are available everywhere. At least one of the two must be enabled.
# DISCORD_GLOBAL_COMMANDS=true
DISCORD_ALLOWED_USER_IDS=

MUSIC_ROOT=/srv/music
# Fields: {artist} {album_artist} {album} {title} {year} {genre}. The file extension is added automatically.
LIBRARY_PATH_TEMPLATE={album_artist}/{album}/{title}
# QUEUE_DIR=/var/lib/music-sprite/queue
# ARCHIVE_DIR=/var/lib/music-sprite/source-metadata
MAX_PLAYLIST_ITEMS=100
# Import automatically when every lookup succeeded and confidence is at least this
# AUTO_IMPORT_CONFIDENCE=0.95
KNOWN_PUBLISHERS=Epic Network,Xkito Music
MUSICBRAINZ_CONTACT=you@example.com
# Audio fingerprint lookup, the most reliable identification. Free key: https://acoustid.org/new-application
# Also needs fpcalc on the server (Arch: chromaprint, Debian/Ubuntu: libchromaprint-tools).
# ACOUSTID_API_KEY=

# Tempo, key and genre guess from the audio itself. Needs the optional extra (INSTALL.md); skipped when it is missing.
ANALYSIS_ENABLED=true
# auto = use the GPU if TensorFlow finds CUDA, cpu = never use it
ANALYSIS_DEVICE=auto
# Models (about 20 MB) are downloaded here on first use
ANALYSIS_MODEL_DIR=/opt/music-sprite/.analysis-model/

# Any OpenAI-compatible server: Ollama, llama.cpp, vLLM, OpenRouter, ...
# Leave LLM_MODEL empty to disable the LLM step.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
# LLM_API_KEY=
# schema = strict JSON schema, object = generic JSON mode, none = parse free text
LLM_JSON_MODE=schema
# LLM_CALL_LOG=/var/lib/music-sprite/llm_calls.jsonl

# Optional: trigger a Navidrome rescan after each add
# NAVIDROME_URL=http://localhost:4533
# NAVIDROME_USER=
# NAVIDROME_PASSWORD=
