DISCORD_TOKEN=
# Setting the guild makes the /queue commands appear instantly instead of after up to an hour
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
DISCORD_ALLOWED_USER_IDS=

MUSIC_ROOT=/srv/music
# Fields: {artist} {album_artist} {album} {title} {year} {genre}. The file extension is added automatically.
LIBRARY_PATH_TEMPLATE={album_artist}/{album}/{title}
# QUEUE_DIR=/var/lib/music-sprite/queue
# ARCHIVE_DIR=/var/lib/music-sprite/source-metadata
MAX_PLAYLIST_ITEMS=100
# Import automatically when every lookup succeeded and confidence is at least this
# AUTO_IMPORT_CONFIDENCE=0.95
KNOWN_PUBLISHERS=Epic Network,Xkito Music
MUSICBRAINZ_CONTACT=you@example.com

# Any OpenAI-compatible server: Ollama, llama.cpp, vLLM, OpenRouter, ...
# Leave LLM_MODEL empty to disable the LLM step.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
# LLM_API_KEY=
# schema = strict JSON schema, object = generic JSON mode, none = parse free text
LLM_JSON_MODE=schema
# LLM_CALL_LOG=/var/lib/music-sprite/llm_calls.jsonl

# Optional: trigger a Navidrome rescan after each add
# NAVIDROME_URL=http://localhost:4533
# NAVIDROME_USER=
# NAVIDROME_PASSWORD=
